rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Favoritos / progreso: cada usuario solo accede a lo suyo
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Metadatos de IMDb cacheados: los lee cualquiera,
    // solo los escribe el administrador (pon TU correo de Google)
    match /catalog/{seriesId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "TU_CORREO@gmail.com";
    }
  }
}
